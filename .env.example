# Variables publicas para la app movil CASEI.
# Flutter no carga este archivo automaticamente; usalo como referencia para:
# flutter run --dart-define=EXPO_PUBLIC_SUPABASE_URL=... --dart-define=EXPO_PUBLIC_SUPABASE_ANON_KEY=...

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SEGMENTATION_STORAGE_BUCKET=academic-segmentation

# Tu bucket actual no muestra carpeta "latest"; deja el prefix vacio.
# Si despues subes artefactos bajo latest/, usa: EXPO_PUBLIC_SEGMENTATION_STORAGE_PREFIX=latest
EXPO_PUBLIC_SEGMENTATION_STORAGE_PREFIX=

# Compatibilidad opcional con nombres Flutter existentes.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SEGMENTATION_STORAGE_BUCKET=academic-segmentation
SEGMENTATION_STORAGE_PREFIX=

# Nunca configurar en movil:
# SUPABASE_SERVICE_ROLE_KEY=
